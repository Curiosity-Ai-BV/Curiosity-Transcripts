# Local Whisper is optional. The desktop app also supports saving this path in settings.
CURIOSITY_WHISPER_MODEL=

# Optional local transcription smoke input.
CURIOSITY_WHISPER_WAV=

# Local Ollama defaults are configured in the desktop Settings pane, not read from env.
# Default base URL: http://127.0.0.1:11434
# Default model: qwen3.6:27b
# The local path is intended for localhost/loopback only and does not require hosted secrets.

# Optional hosted/provider secrets. Leave unset for the local MVP unless explicitly testing hosted paths.
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
