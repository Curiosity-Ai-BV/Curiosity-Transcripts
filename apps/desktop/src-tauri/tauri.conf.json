{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Curiosity Transcripts",
  "version": "0.1.18",
  "identifier": "com.curiosity.transcripts",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Curiosity Transcripts",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'"],
        "style-src": ["'self'"],
        "img-src": ["'self'"],
        "font-src": ["'self'"],
        "connect-src": ["ipc:", "http://ipc.localhost"],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "form-action": ["'none'"],
        "frame-ancestors": ["'none'"],
        "frame-src": ["'none'"],
        "worker-src": ["'none'"],
        "media-src": ["'none'"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "publisher": "Curiosity",
    "shortDescription": "Local-first meeting transcription for macOS.",
    "longDescription": "Curiosity Transcripts records local meeting audio, transcribes it with a local Whisper model, and keeps transcripts, summaries, exports, and private artifacts under local user control.",
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "infoPlist": "Info.plist"
    }
  }
}
